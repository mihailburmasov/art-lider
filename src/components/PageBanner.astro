---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  focal?: string;
}

const { image, alt, focal = 'center' } = Astro.props;
---

<div class="page-banner">
  <div class="page-banner__bg">
    <Image src={image} alt={alt} width={1600} loading="eager" fetchpriority="high" style={`object-position:${focal}`} />
  </div>
  <div class="page-banner__overlay"></div>
  <div class="container">
    <div class="page-banner__content">
      <slot />
    </div>
  </div>
</div>
