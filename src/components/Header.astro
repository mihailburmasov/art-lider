---
import { site } from '../config/site';
import { services } from '../data/services';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';
---

<header class="site-header">
  <div class="container site-header__bar">
    <a href={withBase('/')} class="logo" aria-label={`${site.companyName} — на главную`}>
      <Icon name="roller" class="logo__mark" style="width:30px;height:30px" />
      <span>
        {site.legalBrand}
        <span class="logo__sub">{site.tagline}</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Основная навигация">
      <ul>
        <li class="has-dropdown">
          <button aria-haspopup="true" aria-expanded="false" type="button">
            Услуги <Icon name="chevronDown" style="width:14px;height:14px" />
          </button>
          <ul class="dropdown">
            {services.map((s) => (
              <li><a href={withBase(`/uslugi/${s.slug}/`)}>{s.shortTitle}</a></li>
            ))}
            <li><a href={withBase('/uslugi/')}><strong>Все услуги</strong></a></li>
          </ul>
        </li>
        <li><a href={withBase('/raboty/')}>Наши работы</a></li>
        <li><a href={withBase('/ceny/')}>Цены</a></li>
        <li><a href={withBase('/o-kompanii/')}>О компании</a></li>
        <li><a href={withBase('/otzyvy/')}>Отзывы</a></li>
        <li><a href={withBase('/kontakty/')}>Контакты</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={site.phone.href}>{site.phone.display}</a>
      <button type="button" class="btn btn-primary btn-sm" data-open-callback-modal>Оставить заявку</button>
      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Открыть меню"
        id="burger-toggle"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" data-open="false" aria-label="Мобильная навигация">
    <ul>
      <li>
        <details>
          <summary>Услуги</summary>
          <ul>
            {services.map((s) => (
              <li><a href={withBase(`/uslugi/${s.slug}/`)}>{s.shortTitle}</a></li>
            ))}
            <li><a href={withBase('/uslugi/')}>Все услуги</a></li>
          </ul>
        </details>
      </li>
      <li><a href={withBase('/raboty/')}>Наши работы</a></li>
      <li><a href={withBase('/ceny/')}>Цены</a></li>
      <li><a href={withBase('/o-kompanii/')}>О компании</a></li>
      <li><a href={withBase('/otzyvy/')}>Отзывы</a></li>
      <li><a href={withBase('/kontakty/')}>Контакты</a></li>
      <li><a href={site.phone.href}>{site.phone.display}</a></li>
    </ul>
    <button type="button" class="btn btn-primary btn-block" data-open-callback-modal>Оставить заявку</button>
  </nav>
</header>

<script>
  const burger = document.getElementById('burger-toggle');
  const nav = document.getElementById('mobile-nav');

  burger?.addEventListener('click', () => {
    const isOpen = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', String(!isOpen));
    burger.setAttribute('aria-expanded', String(!isOpen));
    document.body.style.overflow = !isOpen ? 'hidden' : '';
  });

  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      nav.setAttribute('data-open', 'false');
      burger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  document.querySelectorAll('.has-dropdown > button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  });
</script>
