---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { withBase } from '../../lib/url';
import posterSrc from '../../assets/brand/o-kompanii-poster.jpg';

const poster = await getImage({ src: posterSrc, width: 720 });

const guarantees = [
  { icon: 'document', title: 'Договор на все виды работ', text: 'Фиксируем объём, сроки и стоимость до начала ремонта.' },
  { icon: 'shield', title: 'Гарантия', text: 'Гарантийные обязательства на выполненные работы прописаны в договоре.' },
  { icon: 'check', title: 'Смета до начала работ', text: 'Итоговая стоимость не меняется без согласования с заказчиком.' },
];
---

<BaseLayout
  title="О компании «Арт Лидер»"
  description={`«${site.companyName}» — ремонт квартир и офисов в Лысьве и Чусовом. Свой офис, свои бригады, договор и гарантия на все виды работ.`}
  path="/o-kompanii/"
>
  <Breadcrumbs items={[{ name: 'О компании', path: '/o-kompanii/' }]} />

  <section style="padding-top:8px;">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="eyebrow">О компании</span>
          <h1>«Арт Лидер» — ремонт квартир и офисов в Лысьве и Чусовом</h1>
          <p class="lead">
            Мы занимаемся ремонтом квартир, офисов и частных домов в Лысьве, Чусовом и ближайших населённых пунктах Пермского края.
            В штате — электрики, сантехники, отделочники и монтажники натяжных потолков, поэтому большинство работ выполняем
            своими силами, без привлечения сторонних бригад на каждый этап.
          </p>
          <p>
            Офис компании находится в Лысьве, на ул. Федосеева, 37 — сюда можно приехать на консультацию, посмотреть образцы
            материалов и обсудить проект очно.
            {/* TODO: дополнить историю компании — дата основания, количество выполненных объектов и т.п. */}
          </p>
        </div>
        <figure style="margin:0;">
          <video
            class="about-video"
            poster={poster.src}
            controls
            preload="none"
            playsinline
            aria-label="Видео об офисе и компании Арт Лидер"
          >
            <source src={withBase('/video/o-kompanii.mp4')} type="video/mp4" />
          </video>
          <figcaption style="margin-top:8px;font-size:0.85rem;color:var(--color-gray-500);text-align:center;">
            Директор компании «{site.companyName}» — {site.director}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Гарантии</span>
        <h2>Работаем официально</h2>
      </div>
      <div class="grid grid-3">
        {guarantees.map((g) => (
          <div class="card advantage-card">
            <div class="advantage-card__icon"><Icon name={g.icon} style="width:24px;height:24px" /></div>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div style="max-width:640px;">
        <span class="eyebrow">Реквизиты</span>
        <h2>Юридическая информация</h2>
        <ul style="display:grid;gap:8px;">
          <li>ИП {site.legal.fullName}</li>
          <li>Директор: {site.director}</li>
          <li>ИНН {site.legal.inn}</li>
          <li>ОГРНИП {site.legal.ogrnip}</li>
          <li>Адрес: {site.address.full}</li>
          <li>Режим работы: {site.workingHours.text}</li>
        </ul>
        <p class="lead" style="font-size:0.85rem;margin-top:14px;">
          См. также <a href={withBase('/politika-konfidencialnosti/')}>политику конфиденциальности</a> и
          <a href={withBase('/soglasie/')}>согласие на обработку персональных данных</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
