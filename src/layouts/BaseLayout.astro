---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MessengerWidget from '../components/MessengerWidget.astro';
import CallbackModal from '../components/CallbackModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../config/site';
import { localBusinessJsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, path, noindex = false, ogImage } = Astro.props;
const fullTitle = title.includes(site.companyName) ? title : `${title} — ремонт в Лысьве и Чусовом | ${site.companyName}`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <SeoHead title={fullTitle} description={description} path={path} noindex={noindex} ogImage={ogImage} />
    <JsonLd data={localBusinessJsonLd()} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MessengerWidget />
    <CallbackModal />
    <CookieBanner />

    {site.yandexMetrikaId && (
      <script define:vars={{ id: site.yandexMetrikaId }} is:inline>
        window.addEventListener('load', () => {
          setTimeout(() => {
            (function (m, e, t, r, i, k, a) {
              m[i] =
                m[i] ||
                function () {
                  (m[i].a = m[i].a || []).push(arguments);
                };
              m[i].l = 1 * new Date();
              // eslint-disable-next-line prefer-rest-params
              for (var j = 0; j < document.scripts.length; j++) {
                if (document.scripts[j].src === r) return;
              }
              (k = e.createElement(t)),
                (a = e.getElementsByTagName(t)[0]),
                (k.async = 1),
                (k.src = r),
                a.parentNode.insertBefore(k, a);
            })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

            ym(id, 'init', {
              clickmap: true,
              trackLinks: true,
              accurateTrackBounce: true,
              webvisor: false,
            });
          }, 1500);
        });
      </script>
      <noscript>
        <div><img src={`https://mc.yandex.ru/watch/${site.yandexMetrikaId}`} style="position:absolute;left:-9999px;" alt="" /></div>
      </noscript>
    )}
  </body>
</html>
